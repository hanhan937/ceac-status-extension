{
  "manifest_version": 3,
  "name": "CEAC Status Prefill",
  "version": "1.0.0",
  "description": "Open the official CEAC visa status tracker and prefill saved fields. CAPTCHA and submission stay manual.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "CEAC Status Prefill"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://ceac.state.gov/CEACStatTracker/Status.aspx*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
